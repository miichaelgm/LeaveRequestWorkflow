            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        }
      },
      "actions": {
        "Condition": {
          "actions": {
            "Get_items": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://sprobe.sharepoint.com/sites/LeaveRequestPowerPlatform",
                  "table": "ca6922d0-3ccb-4ac3-b4bd-910efc9723ee",
                  "$filter": "Employee/EMail eq '@{triggerBody()?['Approver/Email']}' and IsActive eq 1",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Condition_2": {
              "actions": {
                "Condition_3": {
                  "actions": {
                    "Post_message_in_a_chat_or_channel": {
                      "runAfter": {
                        "Send_an_email_(V2)": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "body/recipient": "@triggerBody()?['Approver/Email']",
                          "body/messageBody": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']}さんが@{triggerBody()?['LeaveType/Value']}を申請しました。<br><br>開始日: @{triggerBody()?['StartDate']}<br>終了日: @{triggerBody()?['EndDate']}</p>"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                          "operationId": "PostMessageToConversation",
                          "connectionName": "shared_teams"
                        }
                      }
                    },
                    "Send_an_email_(V2)": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "emailMessage/To": "@triggerBody()?['Approver/Email']",
                          "emailMessage/Subject": "新しい休暇申請　申請者： @{triggerBody()?['Requester/DisplayName']}\n",
                          "emailMessage/Body": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']}さんが@{triggerBody()?['LeaveType/Value']}を申請しました。<br><br>開始日: @{triggerBody()?['StartDate']}<br>終了日: @{triggerBody()?['EndDate']}</p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2",
                          "connectionName": "shared_office365-4"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Send_an_email_(V2)_2": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "emailMessage/To": "@triggerBody()?['Approver/Email']",
                            "emailMessage/Subject": "New Leave Request From: @{triggerBody()?['Requester/DisplayName']}",
                            "emailMessage/Body": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']} has requested a @{triggerBody()?['LeaveType/Value']}.<br><br>Start Date: @{triggerBody()?['StartDate']}<br>End Date: @{triggerBody()?['EndDate']}</p>",
                            "emailMessage/Importance": "Normal"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "operationId": "SendEmailV2",
                            "connectionName": "shared_office365-5"
                          }
                        }
                      },
                      "Post_message_in_a_chat_or_channel_2": {
                        "runAfter": {
                          "Send_an_email_(V2)_2": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "poster": "Flow bot",
                            "location": "Chat with Flow bot",
                            "body/recipient": "@triggerBody()?['Approver/Email']",
                            "body/messageBody": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']} has requested a @{triggerBody()?['LeaveType/Value']}.<br><br>Start Date: @{triggerBody()?['StartDate']}<br>End Date: @{triggerBody()?['EndDate']}</p>"
