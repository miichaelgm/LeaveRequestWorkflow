                          "emailMessage/Body": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']}さんが@{triggerBody()?['LeaveType/Value']}の申請を取り消しました。<br><br>開始日: @{triggerBody()?['StartDate']}<br>終了日: @{triggerBody()?['EndDate']}</p><p class=\"editor-paragraph\"></p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2",
