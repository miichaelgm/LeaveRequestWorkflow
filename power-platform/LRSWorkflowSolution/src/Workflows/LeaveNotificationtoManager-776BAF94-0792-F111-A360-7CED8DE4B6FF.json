                            "operationId": "PostMessageToConversation",
                            "connectionName": "shared_teams-1"
                          }
                        }
                      }
                    }
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@first(body('Get_items')?['value'])?['IsJapanese']",
                          true
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Get_items": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@int(length(body('Get_items')?['value']))",
                      0
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {},
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerBody()?['Status/Value']",
                  "Pending"
                ]
              },
              {
                "not": {
                  "equals": [
                    "@triggerBody()?['ApproverEmailSent']",
                    "@true"
                  ]
                }
              }
            ]
          },
          "type": "If"
        },
        "Condition_1": {
          "actions": {
            "Get_items_1": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://sprobe.sharepoint.com/sites/LeaveRequestPowerPlatform",
                  "table": "ca6922d0-3ccb-4ac3-b4bd-910efc9723ee",
                  "$filter": "Employee/EMail eq '@{triggerBody()?['Requester/Email']}' and IsActive eq 1",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline-1"
