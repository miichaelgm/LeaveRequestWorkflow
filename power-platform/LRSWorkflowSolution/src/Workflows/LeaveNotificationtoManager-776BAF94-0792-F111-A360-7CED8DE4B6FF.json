                          "parameters": {
                            "emailMessage/To": "@triggerBody()?['Approver/Email']",
                            "emailMessage/Subject": "[TESTING ONLY] Leave Request Cancelled by: @{triggerBody()?['Requester/DisplayName']}",
                            "emailMessage/Body": "<p class=\"editor-paragraph\">@{triggerBody()?['Requester/DisplayName']} has cancelled the @{triggerBody()?['LeaveType/Value']} request.<br><br>Start Date: @{triggerBody()?['StartDate']}<br>End Date: @{triggerBody()?['EndDate']}</p>",
                            "emailMessage/Importance": "Normal"
